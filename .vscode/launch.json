{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Python File",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Flight Booking Example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/flight_booking.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}